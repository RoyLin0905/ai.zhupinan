# 竹聘安決賽示範系統｜環境變數範本
# 這個檔案只列變數名稱，不放真實值。真實值設在終端機環境變數或 demo/server/line.env（已列入 .gitignore）。

# 合成資料示範模式的唯一標記。此版本只接受 true；其他值會拒絕啟動。
DEMO_DATA=true

# LINE Messaging API（選用；未設定時 LINE 功能只顯示預覽）
# 也可改寫在 demo/server/line.env，格式見 demo/server/line.env.example
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 驗證腳本用（選用）
# DOCS_DIR=docs_holiday   # score.py / extract.py 改用連假測試集
# QSET=holdout            # qa.py 改用 10 題保留題
